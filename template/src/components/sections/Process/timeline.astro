---
/**
 * Process/timeline — Vertical timeline with connecting line and dots.
 * Renders contentHtml if provided; otherwise shows the default 3-step process.
 */
interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props

const defaultSteps = [
  {
    number: 1,
    title: 'Call for a Quote',
    description: 'Reach out by phone or through our contact form. We\u2019ll discuss your project, answer questions, and provide a free estimate.',
  },
  {
    number: 2,
    title: 'We Prep and Plan',
    description: 'Our team evaluates the work site, selects the right materials, and schedules a time that fits your calendar.',
  },
  {
    number: 3,
    title: 'Professional Installation',
    description: 'Our crew completes the job on time, walks you through the finished result, and makes sure you\u2019re satisfied.',
  },
]
---

<section class="process-timeline" id={sectionName} aria-labelledby={`${sectionName}-heading`}>
  <div class="process-timeline__inner">
    <h2 id={`${sectionName}-heading`} class="process-timeline__heading">How It Works</h2>

    {contentHtml ? (
      <div class="process-timeline__custom" set:html={contentHtml} />
    ) : (
      <ol class="process-timeline__list">
        {defaultSteps.map((step, idx) => (
          <li class="process-timeline__item" data-last={idx === defaultSteps.length - 1 ? '' : undefined}>
            <div class="process-timeline__marker" aria-hidden="true">
              <span class="process-timeline__dot">{step.number}</span>
              {idx < defaultSteps.length - 1 && <span class="process-timeline__line" />}
            </div>
            <div class="process-timeline__content">
              <h3 class="process-timeline__title">{step.title}</h3>
              <p class="process-timeline__desc">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .process-timeline {
    padding: var(--space-2xl) var(--space-m);
    background-color: var(--surface);
    color: var(--text);
  }

  .process-timeline__inner {
    max-width: 40rem;
    margin: 0 auto;
  }

  .process-timeline__heading {
    font-family: var(--font-display);
    font-size: var(--step-3);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .process-timeline__custom {
    line-height: 1.6;
  }

  .process-timeline__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .process-timeline__item {
    display: flex;
    align-items: stretch;
    gap: var(--space-m);
  }

  .process-timeline__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 2.5rem;
  }

  .process-timeline__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--accent);
    color: var(--accent-text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1;
    flex-shrink: 0;
  }

  .process-timeline__line {
    display: block;
    width: 2px;
    flex: 1;
    min-height: 1.5rem;
    background-color: var(--border);
  }

  .process-timeline__content {
    padding-bottom: var(--space-l);
    min-width: 0;
  }

  /* Remove bottom padding on the last item */
  .process-timeline__item[data-last] .process-timeline__content {
    padding-bottom: 0;
  }

  .process-timeline__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }

  .process-timeline__desc {
    color: var(--muted);
    font-size: var(--step-0);
    line-height: 1.6;
  }
</style>
