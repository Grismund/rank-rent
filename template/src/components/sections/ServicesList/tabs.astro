---
/**
 * ServicesList — tabs variant
 * Tab-button layout linking to service pages. CSS-only, no JS.
 */
interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props

const services = (site.pages ?? []).filter(
  (p: { type: string }) => p.type === 'service',
)
---

<section class="services-tabs" id={sectionName}>
  {contentHtml ? (
    <div class="services-tabs__intro" set:html={contentHtml} />
  ) : (
    <h2 class="services-tabs__heading">Our Services</h2>
  )}

  {services.length > 0 && (
    <nav class="services-tabs__nav" aria-label="Services">
      {services.map((svc: { slug: string; h1: string; primary_keyword: string }) => (
        <a href={`/${svc.slug}/`} class="services-tabs__tab">
          {svc.h1}
        </a>
      ))}
    </nav>
  )}
</section>

<style>
  .services-tabs {
    padding: var(--space-l) var(--space-m);
    background-color: var(--bg);
    color: var(--text);
  }

  .services-tabs__intro {
    max-width: 48rem;
    margin-bottom: var(--space-l);
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .services-tabs__intro :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-bottom: var(--space-s);
  }

  .services-tabs__heading {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-bottom: var(--space-l);
  }

  .services-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .services-tabs__tab {
    display: inline-block;
    padding: var(--space-s) var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    color: var(--accent);
    background-color: var(--surface);
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .services-tabs__tab:hover,
  .services-tabs__tab:focus-visible {
    background-color: var(--accent);
    color: var(--accent-text);
    outline: none;
  }

  /* Stack to full-width on narrow viewports */
  @media (max-width: 479px) {
    .services-tabs__nav {
      flex-direction: column;
    }

    .services-tabs__tab {
      text-align: center;
      white-space: normal;
    }
  }
</style>
