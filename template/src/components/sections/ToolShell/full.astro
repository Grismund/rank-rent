---
/**
 * ToolShell/full — Full-width tool container.
 * Renders a placeholder that Preact hydrates in Group 3.
 */
interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props
const toolType = site.tool?.type ?? 'calculator'
const toolKeyword = site.tool?.primary_keyword ?? 'cost'
---

<section class="tool-shell-full" aria-label={sectionName}>
  <div class="tool-container">
    {contentHtml && (
      <div class="tool-intro" set:html={contentHtml} />
    )}
    <div
      class="tool-placeholder"
      data-tool-type={toolType}
      role="status"
      aria-live="polite"
    >
      <div class="tool-loading">
        <div class="tool-loading-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 9h3v2H8zm5 0h3v2h-3zm-5 4h3v2H8zm5 4h3v2h-3zm5-4h-3v-2h3z" fill="currentColor" opacity="0.4" />
          </svg>
        </div>
        <p class="tool-loading-text">Loading {toolKeyword} calculator&hellip;</p>
        <p class="tool-loading-hint">Interactive tool — enter your details for an instant estimate.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .tool-shell-full {
    padding: var(--section-gap) var(--space-m);
    background-color: var(--surface);
  }

  .tool-container {
    max-width: 64rem;
    margin-inline: auto;
  }

  .tool-intro {
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-l);
    text-align: center;
    color: var(--text);
    line-height: 1.6;
  }

  .tool-intro :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-bottom: var(--space-s);
  }

  .tool-intro :global(p) {
    color: var(--muted);
    font-size: var(--step-0);
  }

  .tool-placeholder {
    min-height: 18rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg);
  }

  .tool-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    text-align: center;
    padding: var(--space-l);
  }

  .tool-loading-icon {
    color: var(--accent);
    opacity: 0.7;
  }

  .tool-loading-text {
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--muted);
    margin: 0;
  }

  .tool-loading-hint {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--muted);
    opacity: 0.6;
    margin: 0;
  }

  @media (max-width: 360px) {
    .tool-shell-full {
      padding-inline: var(--space-s);
    }

    .tool-placeholder {
      min-height: 14rem;
      border-left: none;
      border-right: none;
      border-radius: 0;
    }

    .tool-loading {
      padding: var(--space-m);
    }
  }
</style>
