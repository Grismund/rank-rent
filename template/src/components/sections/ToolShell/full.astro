---
/**
 * ToolShell/full — Full-width tool container.
 * ToolRouter hydrates on scroll via client:visible.
 */
import ToolRouter from '../../tools/ToolRouter'

interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props
const toolType = site.tool?.type ?? 'calculator'
const toolKeyword = site.tool?.primary_keyword ?? 'cost'
const phone = site.phone ?? null
const ctaPrimary = site.copy?.cta?.primary ?? 'Call for a Free Quote'
const siteState = site.state ?? ''
const city = site.city ?? ''
---

<section class="tool-shell-full" aria-label={sectionName}>
  <div class="tool-container">
    {contentHtml && (
      <div class="tool-intro" set:html={contentHtml} />
    )}
    <div
      class="tool-placeholder"
      data-tool-type={toolType}
    >
      <ToolRouter
        client:visible
        toolType={toolType}
        phone={phone}
        ctaPrimary={ctaPrimary}
        state={siteState}
        city={city}
      />
    </div>
    <noscript>
      <div class="tool-noscript">
        <p>This interactive {toolKeyword} calculator requires JavaScript.</p>
        {phone ? (
          <p>Call <a href={`tel:${phone}`}>{phone}</a> for a free estimate, or <a href="/contact/">fill out our contact form</a>.</p>
        ) : (
          <p><a href="/contact/">Fill out our contact form</a> for a free estimate.</p>
        )}
      </div>
    </noscript>
  </div>
</section>

<style>
  .tool-shell-full {
    padding: var(--section-gap) var(--space-m);
    background-color: var(--surface);
  }

  .tool-container {
    max-width: 64rem;
    margin-inline: auto;
  }

  .tool-intro {
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-l);
    text-align: center;
    color: var(--text);
    line-height: 1.6;
  }

  .tool-intro :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-bottom: var(--space-s);
  }

  .tool-intro :global(p) {
    color: var(--muted);
    font-size: var(--step-0);
  }

  .tool-placeholder {
    min-height: 18rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg);
    padding: var(--space-l);
  }

  .tool-noscript {
    padding: var(--space-l);
    text-align: center;
    color: var(--muted);
    font-size: var(--step-0);
  }

  .tool-noscript a {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 360px) {
    .tool-shell-full {
      padding-inline: var(--space-s);
    }

    .tool-placeholder {
      min-height: 14rem;
      border-left: none;
      border-right: none;
      border-radius: 0;
    }
  }
</style>
