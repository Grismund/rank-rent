---
/**
 * ToolShell/split — Split layout: tool on one side, description on the other.
 * ToolRouter hydrates on scroll via client:visible.
 */
import ToolRouter from '../../tools/ToolRouter'

interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props
const toolType = site.tool?.type ?? 'calculator'
const toolKeyword = site.tool?.primary_keyword ?? 'cost'
const phone = site.phone ?? null
const ctaPrimary = site.copy?.cta?.primary ?? 'Call for a Free Quote'
const siteState = site.state ?? ''
const city = site.city ?? ''
---

<section class="tool-shell-split" aria-label={sectionName}>
  <div class="tool-split-grid">
    <div class="tool-side">
      <div
        class="tool-placeholder"
        data-tool-type={toolType}
      >
        <ToolRouter
          client:visible
          toolType={toolType}
          phone={phone}
          ctaPrimary={ctaPrimary}
          state={siteState}
          city={city}
        />
      </div>
      <noscript>
        <div class="tool-noscript">
          <p>This interactive {toolKeyword} calculator requires JavaScript.</p>
          {phone ? (
            <p>Call <a href={`tel:${phone}`}>{phone}</a> for a free estimate, or <a href="/contact/">fill out our contact form</a>.</p>
          ) : (
            <p><a href="/contact/">Fill out our contact form</a> for a free estimate.</p>
          )}
        </div>
      </noscript>
    </div>
    <div class="description-side">
      {contentHtml ? (
        <div class="tool-description" set:html={contentHtml} />
      ) : (
        <div class="tool-description">
          <p>Use our free {toolKeyword} calculator to get an instant estimate for your project.</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .tool-shell-split {
    padding: var(--section-gap) var(--space-m);
  }

  .tool-split-grid {
    max-width: 64rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .tool-side {
    order: 1;
  }

  .description-side {
    order: 2;
  }

  .tool-placeholder {
    min-height: 16rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: var(--space-l);
  }

  .tool-noscript {
    padding: var(--space-l);
    text-align: center;
    color: var(--muted);
    font-size: var(--step-0);
  }

  .tool-noscript a {
    color: var(--accent);
    font-weight: 600;
  }

  .tool-description {
    color: var(--text);
    line-height: 1.6;
  }

  .tool-description :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-bottom: var(--space-s);
  }

  .tool-description :global(h3) {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-top: var(--space-l);
    margin-bottom: var(--space-s);
  }

  .tool-description :global(p) {
    color: var(--muted);
    margin-bottom: var(--space-s);
  }

  .tool-description :global(ul),
  .tool-description :global(ol) {
    color: var(--muted);
    padding-left: var(--space-l);
    margin-bottom: var(--space-s);
  }

  .tool-description :global(li) {
    margin-bottom: var(--space-s);
  }

  /* Stack vertically on narrow screens */
  @media (max-width: 768px) {
    .tool-split-grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .tool-side {
      order: 1;
    }

    .description-side {
      order: 2;
    }
  }

  @media (max-width: 360px) {
    .tool-shell-split {
      padding-inline: var(--space-s);
    }

    .tool-placeholder {
      min-height: 12rem;
    }
  }
</style>
