---
/**
 * TrustBlock — checklist variant
 * Presents trust points as a checklist with CSS-only checkmark icons
 * (pseudo-elements, no images or icon fonts). Communicates process
 * transparency and what the homeowner can expect.
 */
interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props
const heading = site.copy?.trust_heading ?? 'How This Works'

const checklistItems = [
  'We match you with an independent local contractor — not a franchise',
  'Every contractor carries their own license and insurance',
  'Get a free quote with no obligation',
  'Your information stays private and is never sold',
  'No hidden fees and no middleman markup on your project',
  'Speak directly with the contractor who will do the work',
]
---

<section class="trust-checklist" aria-labelledby="trust-checklist-heading">
  <div class="trust-checklist-inner">
    <h2 id="trust-checklist-heading">{heading}</h2>

    <ul class="checklist" role="list">
      {checklistItems.map((item) => (
        <li class="checklist-item">
          <span class="check-icon" aria-hidden="true"></span>
          <span class="check-text">{item}</span>
        </li>
      ))}
    </ul>

    {contentHtml && (
      <div class="trust-checklist-extra" set:html={contentHtml} />
    )}
  </div>
</section>

<style>
  .trust-checklist {
    padding: var(--space-2xl) var(--space-m);
    background-color: var(--surface);
  }

  .trust-checklist-inner {
    max-width: 72ch;
    margin-inline: auto;
  }

  #trust-checklist-heading {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--text);
    margin-block-end: var(--space-l);
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .check-icon {
    position: relative;
    flex-shrink: 0;
    width: 1.5em;
    height: 1.5em;
    margin-block-start: 0.1em;
    border: 2px solid var(--accent);
    border-radius: calc(var(--radius) * 0.3);
    background-color: var(--bg);
  }

  .check-icon::after {
    content: '';
    position: absolute;
    top: 0.2em;
    left: 0.4em;
    width: 0.45em;
    height: 0.75em;
    border-right: 2.5px solid var(--accent);
    border-bottom: 2.5px solid var(--accent);
    transform: rotate(45deg);
  }

  .check-text {
    font-size: var(--step-0);
    color: var(--text);
    line-height: 1.5;
  }

  .trust-checklist-extra {
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 360px) {
    .trust-checklist {
      padding: var(--space-xl) var(--space-s);
    }

    .trust-checklist-inner {
      max-width: 100%;
    }

    .check-text {
      word-break: break-word;
      overflow-wrap: break-word;
    }
  }
</style>
