---
/**
 * CTABand/card — Centered card with phone CTA.
 * Variant: card
 */
interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { site, page, contentHtml, sectionName } = Astro.props
const phone = site.phone
const primaryCta = site.copy?.cta?.primary ?? 'Call Now'
const secondaryCta = site.copy?.cta?.secondary ?? ''
---

<section class="cta-card-section" id={sectionName} aria-label={primaryCta}>
  <div class="cta-card">
    {contentHtml && <div class="cta-card__text" set:html={contentHtml} />}
    <a href={`tel:${phone}`} class="cta-card__button">
      <span class="cta-card__label">{primaryCta}</span>
      <span class="cta-card__phone">{phone}</span>
    </a>
    {secondaryCta && <p class="cta-card__secondary">{secondaryCta}</p>}
  </div>
</section>

<style>
  .cta-card-section {
    padding: var(--space-xl) var(--space-m);
    display: flex;
    justify-content: center;
    overflow-x: hidden;
  }

  .cta-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: var(--space-xl) var(--space-l);
    text-align: center;
    max-width: 36rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  .cta-card__text {
    font-size: var(--step-1);
    font-family: var(--font-display);
    line-height: 1.3;
    color: var(--text);
  }

  .cta-card__button {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-s);
    background-color: var(--accent);
    color: var(--accent-text);
    padding: var(--space-s) var(--space-l);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .cta-card__button:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .cta-card__phone {
    font-variant-numeric: tabular-nums;
  }

  .cta-card__secondary {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
