---
interface Props {
  site: any
  page: any
  contentHtml?: string
  sectionName: string
}

const { contentHtml, sectionName } = Astro.props
const headingId = `section-${sectionName}`
const displayName = sectionName.charAt(0).toUpperCase() + sectionName.slice(1).replace(/-/g, ' ')
---

<section id={sectionName} aria-labelledby={headingId}>
  {contentHtml ? (
    <div class="prose-content" set:html={contentHtml} />
  ) : (
    <div class="prose-content">
      <h2 id={headingId}>{displayName}</h2>
      <p>Content coming soon.</p>
    </div>
  )}
</section>

<style>
  section {
    padding: var(--space-l) var(--space-m);
    max-width: 72ch;
    margin-inline: auto;
  }

  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text);
    margin-block-end: var(--space-s);
  }

  .prose-content :global(h3) {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text);
    margin-block: var(--space-m) var(--space-s);
  }

  .prose-content :global(p) {
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--text);
    line-height: 1.7;
    margin-block-end: var(--space-s);
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-inline-start: 1.5em;
    margin-block-end: var(--space-s);
    color: var(--text);
  }

  .prose-content :global(li) {
    margin-block-end: 0.25em;
    line-height: 1.6;
  }

  .prose-content :global(strong) {
    font-weight: 700;
  }

  .prose-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .prose-content :global(a:hover) {
    opacity: 0.85;
  }
</style>
