---
interface NavItem {
  label: string
  href: string
}

interface Props {
  items: NavItem[]
  phone?: string | null
}

const { items, phone } = Astro.props
---

<details class="mobile-nav">
  <summary class="mobile-nav-toggle" aria-label="Menu">
    <span class="hamburger" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </summary>
  <nav class="mobile-nav-panel" aria-label="Mobile navigation">
    <ul class="mobile-nav-list">
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
    {phone && (
      <a href={`tel:${phone}`} class="mobile-nav-phone">
        Call {phone}
      </a>
    )}
  </nav>
</details>

<style>
  .mobile-nav {
    position: relative;
  }

  .mobile-nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: var(--space-s);
    list-style: none;
    background: none;
    border: none;
  }

  .mobile-nav-toggle::-webkit-details-marker {
    display: none;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 24px;
  }

  .hamburger span {
    display: block;
    height: 2px;
    background-color: var(--text);
    border-radius: 1px;
    transition: transform 0.2s, opacity 0.2s;
  }

  details[open] .hamburger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  details[open] .hamburger span:nth-child(2) {
    opacity: 0;
  }

  details[open] .hamburger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav-panel {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 200px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    z-index: 100;
    padding: var(--space-s) 0;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-list li a {
    display: block;
    padding: var(--space-s) var(--space-m);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--step-0);
  }

  .mobile-nav-list li a:hover {
    background: var(--bg);
    color: var(--accent);
  }

  .mobile-nav-phone {
    display: block;
    margin: var(--space-s) var(--space-m);
    padding: var(--space-s);
    text-align: center;
    background: var(--accent);
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-display);
    border-radius: var(--radius);
  }
</style>
